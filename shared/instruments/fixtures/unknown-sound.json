{
  "description": "A sound the app can't play is dropped; the instrument still loads with the player's own sound.",
  "input": {
    "format": "handstrudel.instrument",
    "format_version": 1,
    "id": "builtin.scale-wheel",
    "name": "Scale Wheel",
    "description": "7th chords on one half, the whole scale on the other. Reach into either rim to play an octave up or down.",
    "surface": {
      "type": "split_wheel",
      "radius": 1.0,
      "rest_radius": 0.36,
      "octave_band_radius": 0.8
    },
    "chords": {
      "side": "left",
      "voicing": "seventh"
    },
    "notes": {
      "source": "scale_one_octave",
      "octave_band": true,
      "highlight_chord_tones": true
    },
    "sound": {
      "key": "D",
      "scale": "Pentatonic",
      "progression": "pop",
      "instrument": "theremin_9000",
      "waveform": "sine",
      "use_soundfont": true,
      "bpm": 84,
      "auto_strum": false,
      "pad_volume": 0.3
    }
  },
  "expect": {
    "accepted": true,
    "issues": [
      "sound_dropped"
    ],
    "surface": {
      "radius": 1.0,
      "rest_radius": 0.36,
      "octave_band_radius": 0.8
    },
    "name": "Scale Wheel",
    "has_sound": false
  }
}
