# Copy to supabase/functions/.env (git-ignored) for `supabase functions serve`,
# and set the same values in production with `supabase secrets set --env-file ...`.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=handstrudel-media

# Permanent private clip bucket. The legacy name matches the Cloudflare binding.
R2_VIDEO_STAGING_BUCKET=handstrudel-video-staging
R2_VIDEO_STAGING_ACCESS_KEY_ID=
R2_VIDEO_STAGING_SECRET_ACCESS_KEY=
SIGHTENGINE_API_USER=
SIGHTENGINE_API_SECRET=
VIDEO_MAINTENANCE_TOKEN=
VIDEO_UPLOADS_ENABLED=false

# Invite rewards: a RevenueCat secret API key (v1, starts with sk_) with permission to grant
# promotional entitlements. Without it, rewards stay queued and are granted once it is set.
REVENUECAT_SECRET_KEY=
# Local testing only: point grants at a mock RevenueCat (e.g. http://host.docker.internal:4700/v1).
# Leave unset in production to use https://api.revenuecat.com/v1.
# REVENUECAT_API_URL=
# Optional: lets a scheduled job POST to grant-invite-rewards with X-Invite-Worker-Token to retry the whole queue.
INVITE_WORKER_TOKEN=
