# Copy to supabase/functions/.env (git-ignored) for `supabase functions serve`,
# and set the same values in production with `supabase secrets set --env-file ...`.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=handstrudel-media

# Permanent private clip bucket. The legacy name matches the Cloudflare binding.
R2_VIDEO_STAGING_BUCKET=handstrudel-video-staging
R2_VIDEO_STAGING_ACCESS_KEY_ID=
R2_VIDEO_STAGING_SECRET_ACCESS_KEY=
SIGHTENGINE_API_USER=
SIGHTENGINE_API_SECRET=
VIDEO_MAINTENANCE_TOKEN=
VIDEO_UPLOADS_ENABLED=false

# generate-instrument ("Make your own instrument", docs/ai-instruments.md).
# Anthropic API key (console.anthropic.com). Required; generation falls back to
# the nearest built-in instrument while the model is unreachable.
ANTHROPIC_API_KEY=
# Optional model override (default claude-haiku-5-5).
ANTHROPIC_INSTRUMENT_MODEL=
# Optional: RevenueCat secret key, so Pro and HandStrudel+ players get their higher daily limits.
REVENUECAT_SECRET_KEY=
