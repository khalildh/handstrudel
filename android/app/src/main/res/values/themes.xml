<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Launch window: the default (Volt) studio background, so there is no black flash
         before Compose draws the selected theme. Bars are managed in code (MainActivity /
         HandStrudelApp). -->
    <style name="Theme.HandStrudel" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/studio_background</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
    <color name="studio_background">#0A0C0C</color>
    <color name="ic_launcher_background">#000000</color>
</resources>
